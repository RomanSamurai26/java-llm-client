<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    tools:context=".FirstFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view_chat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/layout_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Historia czatu -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_chat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_chat_bot" />

            <!-- Kontener na prompt i przycisk (Sekcja asystenta) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_bot_presence"
                android:layout_width="270dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:minHeight="345dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/iv_fixed_bot_avatar"
                    android:layout_width="230dp"
                    android:layout_height="400dp"
                    android:layout_marginBottom="-100dp"
                    android:contentDescription="Butler Avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sebastian_wheit"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <View
                    android:id="@+id/view_bubble_arrow"
                    android:layout_width="61dp"
                    android:layout_height="45dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginBottom="-10dp"
                    android:background="@drawable/bg_chat_bot"
                    android:rotation="-60"
                    app:layout_constraintBottom_toTopOf="@+id/iv_fixed_bot_avatar"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_last_bot_message"
                    android:layout_width="252dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_chat_bot"
                    android:maxWidth="280dp"
                    android:padding="12dp"
                    android:text="Ostatnia odpowiedź bota"
                    android:textColor="@color/chat_bot_text"
                    android:textSize="16sp"
                    android:lineSpacingExtra="2dp"
                    app:layout_constraintBottom_toTopOf="@+id/iv_fixed_bot_avatar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layout_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/input_bg"
        android:elevation="4dp"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/edittext_prompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Wpisz swój prompt..."
            android:textColor="@color/input_text"
            android:textColorHint="@color/tab_text_default"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <ImageButton
            android:id="@+id/button_stt"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Mowa na tekst"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_btn_speak_now"
            app:tint="@color/chat_user_bg" />

        <ImageButton
            android:id="@+id/button_first"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="Wyślij"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_upload"
            app:tint="@color/chat_user_bg" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>